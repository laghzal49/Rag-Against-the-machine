"""Generate grounded answers with a lazily loaded local language model."""

from transformers import AutoModelForCausalLM, AutoTokenizer


class Answer:
    """Generate grounded answers from retrieved source passages."""

    def __init__(self, model_name: str = "Qwen/Qwen3-0.6B") -> None:
        """Store the model identifier without loading weights yet.

        Args:
            model_name: Hugging Face model ID or local model directory.
            tokenizer: Huggine face model of tokenzietion
            model: Hugging Face model to use
        """
        self.model = AutoModelForCausalLM.from_pretrained(model_name)
        self.tokrenzier = AutoTokenizer.from_pretrained(model_name)

    def gernrate(self, context):
        ids = self.tokrenzier.apply_chat_template(
            context, tokenize=False, add_prompt_generation=True
        )
        print(ids)
        code = self.tokrenzier.encode(input_ids=ids, return_tensors="pt")
        print(code)


